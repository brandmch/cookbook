generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── NextAuth required tables ──────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Users ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  bio           String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  ownedCookbooks Cookbook[]       @relation("CookbookOwner")
  memberships    CookbookMember[]
  recipes        Recipe[]
}

// ── Cookbooks ─────────────────────────────────────────────────

model Cookbook {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  palette   String   @default("terracotta") // terracotta | sage | clay
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User             @relation("CookbookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CookbookMember[]
  recipes Recipe[]
  invites Invite[]
}

model CookbookMember {
  id         String   @id @default(cuid())
  cookbookId String
  userId     String
  role       Role     @default(MEMBER)
  joinedAt   DateTime @default(now())

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cookbookId, userId])
}

enum Role {
  OWNER
  MEMBER
}

// ── Recipes ───────────────────────────────────────────────────

model Recipe {
  id            String   @id @default(cuid())
  cookbookId    String
  contributorId String
  title         String
  slug          String
  category      String   @default("Mains")
  story         String?  @db.Text
  serves        Int      @default(4)
  time          String?
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cookbook    Cookbook     @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  contributor User         @relation(fields: [contributorId], references: [id])
  ingredients Ingredient[]
  steps       Step[]

  @@unique([cookbookId, slug])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  quantity String?
  unit     String?
  label    String
  order    Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, order])
}

model Step {
  id       String @id @default(cuid())
  recipeId String
  text     String @db.Text
  order    Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, order])
}

// ── Invites ───────────────────────────────────────────────────

model Invite {
  id         String       @id @default(cuid())
  cookbookId String
  email      String
  token      String       @unique @default(cuid())
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)

  @@index([cookbookId, email])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}
